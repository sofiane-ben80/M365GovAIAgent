{
  '$schema': "http://adaptivecards.io/schemas/adaptive-card.json",
  type: "AdaptiveCard",
  version: "1.5",
  body: Table(
    {
      type: "Container",
      bleed: true,
      style: "emphasis",
      items: Table(
        {
          type: "TextBlock",
          text: "Your Sites",
          size: "ExtraLarge",
          weight: "Bolder",
          wrap: true
        },
        {
          type: "TextBlock",
          text: Text(Topic.SiteCount) & " site(s) returned",
          size: "Small",
          isSubtle: true,
          spacing: "None",
          wrap: true
        }
      )
    },
    {
      type: "Container",
      items: ForAll(
        FirstN(Table(ParseJSON(Topic.SitesJson)), Value(Topic.PageSize)) As site,
        {
          type: "Container",
          spacing: "Medium",
          separator: true,
          items: Table(
            {
              type: "ColumnSet",
              columns: Table(
                {
                  type: "Column",
                  width: "stretch",
                  items: Table(
                    {
                      type: "TextBlock",
                      text: Text(site.Value.title),
                      size: "Medium",
                      weight: "Bolder",
                      wrap: true
                    },
                    {
                      type: "TextBlock",
                      text: If(IsBlank(site.Value.siteType), "Site", Text(site.Value.siteType)),
                      size: "Small",
                      color: "Accent",
                      isSubtle: true,
                      spacing: "None",
                      wrap: true
                    }
                  )
                },
                {
                  type: "Column",
                  width: "auto",
                  verticalContentAlignment: "Top",
                  items: Table(
                    {
                      type: "TextBlock",
                      text: Text(site.Value.complianceStatus),
                      weight: "Bolder",
                      color: If(Text(site.Value.complianceStatus) = "COMPLIANT", "Good", "Attention"),
                      horizontalAlignment: "Right",
                      wrap: true
                    },
                    {
                      type: "TextBlock",
                      text: If(
                        Text(site.Value.complianceAction) = "NONE",
                        "No action required",
                        "Action: " & Text(site.Value.complianceAction)
                      ),
                      size: "Small",
                      color: If(Text(site.Value.complianceAction) = "NONE", "Good", "Attention"),
                      horizontalAlignment: "Right",
                      spacing: "None",
                      wrap: true
                    }
                  )
                }
              )
            },
            {
              type: "FactSet",
              spacing: "Small",
              facts: Table(
                {
                  title: "Last activity",
                  value: Text(site.Value.lastActivityDate)
                },
                {
                  title: "Item ID",
                  value: Text(site.Value.itemId)
                }
              )
            },
            {
              type: "ActionSet",
              spacing: "Small",
              actions: Table(
                {
                  type: "Action.Submit",
                  title: "View details",
                  data: {
                    actionSubmitId: "my_sites_view_details",
                    intent: "siteDetail",
                    targetTopic: "SiteDetail",
                    selectedSiteItemId: Value(site.Value.itemId),
                    selectedSiteTitle: Text(site.Value.title),
                    selectedSiteUrl: Text(site.Value.siteUrl)
                  }
                },
                {
                  type: "Action.OpenUrl",
                  title: "Open site",
                  url: Text(site.Value.siteUrl)
                }
              )
            },
            {
              type: "ActionSet",
              spacing: "Small",
              isVisible: Text(site.Value.complianceAction) <> "NONE",
              actions: Table(
                {
                  type: "Action.Submit",
                  title: If(
                    Text(site.Value.complianceAction) = "CERTIFY",
                    "Certify",
                    "Request archive"
                  ),
                  style: If(Text(site.Value.complianceAction) = "CERTIFY", "positive", "default"),
                  data: {
                    actionSubmitId: If(
                      Text(site.Value.complianceAction) = "CERTIFY",
                      "my_sites_certify",
                      "my_sites_request_archive"
                    ),
                    intent: If(
                      Text(site.Value.complianceAction) = "CERTIFY",
                      "certifySite",
                      "requestArchival"
                    ),
                    targetTopic: If(
                      Text(site.Value.complianceAction) = "CERTIFY",
                      "CertifySite",
                      "RequestArchival"
                    ),
                    selectedSiteItemId: Value(site.Value.itemId),
                    selectedSiteTitle: Text(site.Value.title),
                    selectedSiteUrl: Text(site.Value.siteUrl)
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}