      "actions": {
        "Initialize_IsAdmin": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "isAdmin",
                "value": false,
                "type": "boolean"
              }
            ]
          },
          "runAfter": {}
        },
        "Get_AdminUPNs": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://mngenvmcap733570.sharepoint.com/sites/M365Governance",
              "table": "ca14ff4d-e4c5-4324-86d9-848a777c2ca1",
              "$filter": "Title eq \u0027AdminUPNs\u0027",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItems",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runAfter": {
            "Initialize_IsAdmin": [
              "Succeeded"
            ]
          }
        },
        "Check_AdminUPNs_Present": {
          "type": "If",
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(coalesce(outputs(\u0027Get_AdminUPNs\u0027)?[\u0027body\u0027]?[\u0027value\u0027]?[0]?[\u0027SettingValue\u0027], \u0027\u0027))",
                  0
                ]
              }
            ]
          },
          "actions": {
            "Is_Caller_In_Admin_List": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "contains": [
                      "@concat(\u0027,\u0027, toLower(coalesce(outputs(\u0027Get_AdminUPNs\u0027)?[\u0027body\u0027]?[\u0027value\u0027]?[0]?[\u0027SettingValue\u0027], \u0027\u0027)), \u0027,\u0027)",
                      "@concat(\u0027,\u0027, toLower(triggerBody()?[\u0027text\u0027]), \u0027,\u0027)"
                    ]
                  }
                ]
              },
              "actions": {
                "Set_IsAdmin_True": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "isAdmin",
                    "value": true
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Get_AdminUPNs": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Respond_to_agent": {
          "type": "Response",
          "kind": "Skills",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "isadmin": {
