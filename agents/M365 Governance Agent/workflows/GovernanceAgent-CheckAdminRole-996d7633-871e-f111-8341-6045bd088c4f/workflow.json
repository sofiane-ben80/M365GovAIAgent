                  "type": "boolean",
                  "x-ms-content-hint": "BOOLEAN",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "isadmin": "@variables(\u0027isAdmin\u0027)"
            }
          },
          "runAfter": {
            "Check_AdminUPNs_Present": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
