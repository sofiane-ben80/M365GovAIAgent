kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: Request Status
    triggerQueries:
      - request status
      - check my request
      - track request
  actions:
    - kind: Question
      id: question_RequestId
      alwaysPrompt: true
      variable: init:Topic.RequestId
      prompt: Enter the Governor365 request ID.
      entity: StringPrebuiltEntity
    - kind: InvokeFlowAction
      id: invokeFlowAction_GetRequestStatus
      input:
        binding:
          text: =System.User.PrincipalName
          text_1: =Topic.RequestId
      output:
        binding:
          correlationid: Topic.CorrelationId
          datajson: Topic.DataJson
          message: Topic.ResultMessage
          status: Topic.ResultStatus
          success: Topic.Success
      flowId: e8e5cfdb-b9b3-f111-aaac-000d3a367627
    - kind: SendActivity
      id: sendActivity_RequestStatus
      activity: "{Topic.ResultMessage} Status: {Topic.ResultStatus}. Data: {Topic.DataJson} Correlation ID: {Topic.CorrelationId}"
    - kind: CancelAllDialogs
      id: cancelAllDialogs_RequestStatus
