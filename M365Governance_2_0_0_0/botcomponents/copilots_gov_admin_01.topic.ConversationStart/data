kind: AdaptiveDialog
beginDialog:
  kind: OnConversationStart
  id: main
  actions:
    - kind: SetVariable
      id: setVariable_ConversationStartIsAdmin
      variable: init:Topic.IsAdmin
      value: false

    - kind: SendActivity
      id: sendMessage_M0LuhV
      activity:
        text:
          - Hi {System.User.DisplayName}, I am {System.Bot.Name}. I handle tenant-wide governance for admins.
        speak:
          - Hello {System.User.DisplayName}. I handle tenant-wide governance for admins.

    - kind: InvokeFlowAction
      id: invokeFlowAction_VerifyAdmin
      input:
        binding:
          text: =System.User.PrincipalName

      output:
        binding:
          correlationid: Topic.CorrelationId
          isadmin: Topic.IsAdmin
          message: Topic.VerificationMessage
          status: Topic.VerificationStatus
          success: Topic.VerificationSuccess

      flowId: 03fcfb0f-b6b3-f111-aaac-000d3a367627

    - kind: ConditionGroup
      id: conditionGroup_AdminVerification
      conditions:
        - id: conditionItem_AdminVerified
          condition: =Topic.VerificationSuccess = true && Topic.IsAdmin = true
          actions:
            - kind: SendActivity
              id: sendActivity_AdminMenu
              activity: |
                Admin access confirmed.
                You can ask for: admin dashboard, orphaned sites, not attested sites, or assign owner.

      elseActions:
        - kind: SendActivity
          id: sendActivity_AdminDenied
          activity: |
            I could not verify admin access for this account. {Topic.VerificationMessage}
            Status: {Topic.VerificationStatus}
            Correlation ID: {Topic.CorrelationId}

    - kind: CancelAllDialogs
      id: cancelAllDialogs_ConversationStart
