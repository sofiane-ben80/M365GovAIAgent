kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: Flag for Deletion
    triggerQueries:
      - flag for deletion
      - request deletion review
  actions:
    - kind: Question
      id: question_SiteId
      alwaysPrompt: true
      variable: init:Topic.SiteId
      prompt: Enter the Governor365 Dataverse site ID for deletion review.
      entity: StringPrebuiltEntity
    - kind: Question
      id: question_Reason
      alwaysPrompt: true
      variable: init:Topic.Reason
      prompt: Why should this site be reviewed for deletion?
      entity: StringPrebuiltEntity
    - kind: Question
      id: question_Confirmation
      alwaysPrompt: true
      variable: init:Topic.Confirmation
      prompt: This does not delete the site. Type CONFIRM to submit a review request.
      entity: StringPrebuiltEntity
    - kind: InvokeFlowAction
      id: invokeFlowAction_SubmitDeletionReview
      input:
        binding:
          text: =System.User.PrincipalName
          text_1: ="DELETE_REVIEW"
          text_2: =Topic.SiteId
          text_3: =Topic.Reason
          text_4: =Upper(Topic.Confirmation)
          text_5: =Text(GUID())
          text_6: =""
      output:
        binding:
          correlationid: Topic.CorrelationId
          message: Topic.ResultMessage
          requestid: Topic.RequestId
          requeststatus: Topic.RequestStatus
          status: Topic.ResultStatus
          success: Topic.Success
      flowId: 7f675f00-bab3-f111-aaac-000d3a367627
    - kind: SendActivity
      id: sendActivity_DeletionResult
      activity: "{Topic.ResultMessage} Request ID: {Topic.RequestId}. Status: {Topic.RequestStatus}. Correlation ID: {Topic.CorrelationId}"
    - kind: CancelAllDialogs
      id: cancelAllDialogs_FlagForDeletion
