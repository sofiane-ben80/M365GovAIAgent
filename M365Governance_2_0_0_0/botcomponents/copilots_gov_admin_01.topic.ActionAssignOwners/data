kind: AdaptiveDialog
beginDialog:
  kind: OnRecognizedIntent
  id: main
  intent:
    displayName: Assign Owner
    triggerQueries:
      - assign owner
      - assign a site owner
  actions:
    - kind: Question
      id: question_SiteId
      alwaysPrompt: true
      variable: init:Topic.SiteId
      prompt: Enter the Governor365 Dataverse site ID.
      entity: StringPrebuiltEntity
    - kind: Question
      id: question_TargetOwner
      alwaysPrompt: true
      variable: init:Topic.TargetOwnerUPN
      prompt: Enter the target owner's user principal name.
      entity: StringPrebuiltEntity
    - kind: Question
      id: question_Reason
      alwaysPrompt: true
      variable: init:Topic.Reason
      prompt: Why should this owner be assigned?
      entity: StringPrebuiltEntity
    - kind: Question
      id: question_Confirmation
      alwaysPrompt: true
      variable: init:Topic.Confirmation
      prompt: Type CONFIRM to submit the owner-assignment request.
      entity: StringPrebuiltEntity
    - kind: InvokeFlowAction
      id: invokeFlowAction_SubmitOwnerAssignment
      input:
        binding:
          text: =System.User.PrincipalName
          text_1: ="ASSIGN_OWNER"
          text_2: =Topic.SiteId
          text_3: =Topic.Reason
          text_4: =Upper(Topic.Confirmation)
          text_5: =Text(GUID())
          text_6: =Topic.TargetOwnerUPN
      output:
        binding:
          correlationid: Topic.CorrelationId
          message: Topic.ResultMessage
          requestid: Topic.RequestId
          requeststatus: Topic.RequestStatus
          status: Topic.ResultStatus
          success: Topic.Success
      flowId: 7f675f00-bab3-f111-aaac-000d3a367627
    - kind: SendActivity
      id: sendActivity_AssignOwnerResult
      activity: "{Topic.ResultMessage} Request ID: {Topic.RequestId}. Status: {Topic.RequestStatus}. Correlation ID: {Topic.CorrelationId}"
    - kind: CancelAllDialogs
      id: cancelAllDialogs_ActionAssignOwners
