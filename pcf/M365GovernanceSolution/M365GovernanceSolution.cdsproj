<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
  </PropertyGroup>

  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props')" />

  <PropertyGroup>
    <ProjectGuid>dc78602a-78af-4ef4-9179-10c60766f820</ProjectGuid>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <TargetFramework>net462</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <SolutionRootPath>..\..\M365Governance_2_0_0_0</SolutionRootPath>
    <SolutionPackageZipFilePath>..\..\M365Governance_2_0_0_0.zip</SolutionPackageZipFilePath>
  </PropertyGroup>

  <PropertyGroup>
    <SolutionPackageType>Unmanaged</SolutionPackageType>
    <SolutionPackageEnableLocalization>false</SolutionPackageEnableLocalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Governor365AgentChat\Governor365AgentChat.pcfproj" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" />
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets')" />

  <Target Name="ValidateConnectedAgentAuthentication" BeforeTargets="StageCanonicalSolutionMetadata">
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Test-ConnectedAgentAuthentication.ps1&quot; -SolutionPath &quot;$(MSBuildProjectDirectory)\..\..\M365Governance_2_0_0_0&quot;" />
  </Target>

  <Target Name="ValidateSolutionPackageIntegrity" BeforeTargets="StageCanonicalSolutionMetadata">
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Test-SolutionPackageIntegrity.ps1&quot; -SolutionPath &quot;$(MSBuildProjectDirectory)\..\..\M365Governance_2_0_0_0&quot; -SolutionZipPath &quot;$(MSBuildProjectDirectory)\..\..\release\M365Governance_2_0_0_0_managed.zip&quot; -ExpectedPackageType Managed" />
  </Target>

  <Target Name="ValidatePrivilegedFlowAuthorization" BeforeTargets="StageCanonicalSolutionMetadata">
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Test-PrivilegedFlowAuthorization.ps1&quot; -SolutionPath &quot;$(MSBuildProjectDirectory)\..\..\M365Governance_2_0_0_0&quot;" />
  </Target>

  <Target Name="ValidateGovernedActionTopic" BeforeTargets="StageCanonicalSolutionMetadata">
    <Exec
      Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Test-GovernedActionTopic.ps1&quot; -SolutionPath &quot;$(MSBuildProjectDirectory)\..\..\M365Governance_2_0_0_0&quot;" />
  </Target>

  <Target Name="StageCanonicalSolutionMetadata" BeforeTargets="ProcessCdsProjectReferencesOutputs">
    <RemoveDir Directories="$(SolutionPackagerMetadataWorkingDirectory)" Condition="Exists('$(SolutionPackagerMetadataWorkingDirectory)')" />
    <ItemGroup>
      <CanonicalSolutionFiles Include="$(MSBuildProjectDirectory)\..\..\M365Governance_2_0_0_0\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(CanonicalSolutionFiles)"
      DestinationFiles="@(CanonicalSolutionFiles -> '$(SolutionPackagerMetadataWorkingDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CleanUpIntermediateFiles" AfterTargets="PowerAppsPackage">
    <!-- SolutionPackager can retain transient handles to bot components until MSBuild exits. -->
    <Message Importance="Low" Text="Intermediate solution metadata is cleared before the next build." />
  </Target>
</Project>
